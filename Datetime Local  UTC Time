#pragma warning(disable : 4996)

#include <iostream>
#include <ctime>

using namespace std;
int main()
{

    time_t t = time(0);

    char* dt = ctime(&t);

    cout << "Local date and time is: " << dt << "\n";

    tm* gmtm = gmtime(&t);


    dt = asctime(gmtm);
    cout << "UTC date and time is : " << dt << "\n";
    return 0;
}
/*
// ========================================
// مكتبة <ctime>
// ========================================

// time_t
// نوع بيانات يُستخدم لتخزين قيمة تمثل الوقت والتاريخ.

// time()
// تُستخدم للحصول على الوقت الحالي من النظام.

// ctime()
// تحول قيمة الوقت إلى نص يحتوي على التاريخ والوقت المحلي.

// tm
// هيكل (Structure) يحتوي على أجزاء التاريخ والوقت
// مثل السنة والشهر واليوم والساعة والدقيقة والثانية.

// gmtime()
// تحول الوقت إلى بيانات من نوع tm بتوقيت UTC.

// asctime()
// تحول بيانات tm إلى نص يحتوي على التاريخ والوقت.

// UTC
// Universal Coordinated Time
// التوقيت العالمي المنسق، وهو التوقيت المرجعي للعالم.

// Local Time
// الوقت المحلي حسب المنطقة الزمنية الموجودة في الجهاز.

*/
