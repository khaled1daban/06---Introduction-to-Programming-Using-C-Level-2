#include <iostream>
#include <vector>

using namespace std;
int main()
{
    vector <int> vnum{ 11,22,33,44,55,66, };

    cout << "Initial Vector: ";
    for (const int &i : vnum) 
    {
        cout << i << " " ;
    }
    cout << "\n\nUpdated Vector: ";


    for (int &i : vnum) 
    {
        i = 20;
        cout << i << " " ;
    }

    cout << "\n\nUpdated Vector: ";

    vnum[1] = 12;
    vnum[2] = 99;
    vnum.at(4) = 22;
    vnum.at(5) = 67;

    for (int &i :vnum) 
    {
        cout << i << " ";
    }
    

    return 0;
}
