#include <iostream>
#include <string>
#include<vector>
#include <fstream>

using namespace std;
void LoadDataFromFileToVector(string filename , vector <string>& vFileContent)
{
	fstream myfile;
	myfile.open(filename, ios::in);
	if (myfile.is_open()) 
	{
		string line;
		while (getline(myfile,line))
		{
			vFileContent.push_back(line);
		}

		myfile.close();
	}

	
}
int main()
{
	vector <string> vFileContent;

	LoadDataFromFileToVector("myfile", vFileContent);

	for (string &line : vFileContent)
	{
		cout << line << endl;
	}



	return 0;
}
