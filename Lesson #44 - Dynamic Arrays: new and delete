#include <iostream>

using namespace std;
int main()
{
    float num;
    cout << "Enter total number of students:  \n";
    cin >> num;

    float* ptr;

    ptr = new float[num];

    for (int i =0 ; i < num ; i++) 
    {
        cout << "\nEnter grades of students." << i + 1 << ": \n";
        cin >> *(ptr + i);
    }

    cout << "\n\nDisplaying grades of students.";
    for (int i = 0; i < num; i++)
    {
        cout << "Student " << i + 1 << ": " << *(ptr + i) << endl;
    }

    delete[]ptr;

    return 0;
}
